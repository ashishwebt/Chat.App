@Chat.App.API_HostAddress = http://localhost:5081

GET {{Chat.App.API_HostAddress}}/api/
Accept: application/json

###

GET {{Chat.App.API_HostAddress}}/api/conversations
Accept: application/json

###

POST {{Chat.App.API_HostAddress}}/api/chat
Content-Type: application/json
Accept: text/event-stream

{
  "conversationId": null,
  "message": "My name is Ashish."
}
###

POST {{Chat.App.API_HostAddress}}/api/chat
Content-Type: application/json
Accept: text/event-stream

{
  "conversationId": "<conversation>",
  "message": "What is my name?"
}

###

@id = <conversation>

GET {{Chat.App.API_HostAddress}}/api/conversations/{{id}}
Accept: application/json

###

PATCH {{Chat.App.API_HostAddress}}/api/conversations/{{id}}
Content-Type: application/json

{
  "title": "My First Chat"
}

###

DELETE {{Chat.App.API_HostAddress}}/api/conversations/{{id}}
Accept: application/json

###